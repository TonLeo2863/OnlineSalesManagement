
@model IEnumerable<OnlineSalesManagement.SalesOrder>

@{
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="page-header document-page-header">
    <div><h1 class="page-title">Quản lý xuất kho và bán hàng</h1><p class="page-subtitle">Theo dõi chứng từ và tra cứu theo điều kiện.</p></div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Tạo đơn bán hàng</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@Html.Partial("_DocumentFilters")
<p class="result-meta" role="status">@Model.Count() chứng từ phù hợp</p>
<div class="panel table-responsive"><table class="table table-hover align-middle data-table">
    <thead>
        <tr>
            <th>Số đơn hàng</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th>Kênh bán</th>
            <th>Trạng thái</th>
            <th class="text-end">Tổng tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderNumber</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @(item.Customer != null
                    ? item.Customer.FullName
                    : "")
                </td>
                <td>@(item.Channel == OnlineSalesManagement.SalesChannel.Online ? "Trực tuyến" : "Tại quầy")</td>
                <td><span class="badge @(item.Status.ToString() == "Cancelled" ? "bg-secondary" : item.Status.ToString() == "Draft" || item.Status.ToString() == "Pending" ? "bg-warning text-dark" : "bg-success")">@(item.Status == OnlineSalesManagement.OrderStatus.Pending ? "Chờ xác nhận" : item.Status == OnlineSalesManagement.OrderStatus.Confirmed ? "Đã xác nhận" : item.Status == OnlineSalesManagement.OrderStatus.Completed ? "Hoàn tất" : "Đã hủy")</span></td>
                <td class="text-end text-nowrap">@item.TotalAmount.ToString("N0") đ</td>
                <td>
                    @Html.ActionLink(
                             "Chi tiết",
                             "Details",
                             new { id = item.Id },
                             new { @class = "btn btn-sm btn-outline-primary" })
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-center text-muted p-4">Không có chứng từ phù hợp.</p> }
</div>
