@model OnlineSalesManagement.PaymentMethod
@{
    var label = Model == OnlineSalesManagement.PaymentMethod.CashOnDelivery ? "Thanh toán khi nhận hàng"
        : Model == OnlineSalesManagement.PaymentMethod.Cash ? "Tiền mặt"
        : Model == OnlineSalesManagement.PaymentMethod.BankTransfer ? "Chuyển khoản" : "Chưa xác định";
}
@label
