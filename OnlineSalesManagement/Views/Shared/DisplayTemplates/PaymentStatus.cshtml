@model OnlineSalesManagement.PaymentStatus
@{
    var label = Model == OnlineSalesManagement.PaymentStatus.Unpaid ? "Chưa thanh toán"
        : Model == OnlineSalesManagement.PaymentStatus.Paid ? "Đã thanh toán"
        : Model == OnlineSalesManagement.PaymentStatus.Refunded ? "Đã hoàn tiền" : "Chưa xác định";
}
@label
