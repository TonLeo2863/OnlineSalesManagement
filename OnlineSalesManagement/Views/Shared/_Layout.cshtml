@using System.Linq
@using System.Collections.Generic
@functions {
    // Danh sách Controller THỰC SỰ có trong project (có action Index), tính một lần khi view được nạp.
    // Khi bạn thêm CategoriesController, CustomersController... menu tương ứng tự động được bật,
    // không cần sửa lại file này.
    private static readonly HashSet<string> AvailableControllers = BuildControllerSet();

    private static HashSet<string> BuildControllerSet()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var types = typeof(OnlineSalesManagement.Controllers.HomeController).Assembly.GetExportedTypes();
        foreach (var t in types)
        {
            if (t.IsAbstract || !t.Name.EndsWith("Controller")) { continue; }
            if (!typeof(System.Web.Mvc.IController).IsAssignableFrom(t)) { continue; }
            if (!t.GetMethods().Any(m => m.Name == "Index")) { continue; }
            set.Add(t.Name.Substring(0, t.Name.Length - "Controller".Length));
        }
        return set;
    }

    private bool CanAccess(string name)
    {
        return OnlineSalesManagement.Services.NavigationAccess.CanAccess(User, name);
    }

    private static bool HasController(string name)
    {
        return AvailableControllers.Contains(name);
    }
}
@{
    // ===== Cấu hình menu quản trị: sửa ở đây nếu tên Controller của bạn khác =====
    var menu = new[]
    {
        new { Section = "Mua hàng", Text = "Cửa hàng trực tuyến", Icon = "bi-cart", Controller = "Store" },
        new { Section = "Hệ thống", Text = "Người dùng", Icon = "bi-person-lock", Controller = "AdminUsers" },
        new { Section = "Kho", Text = "Tồn kho", Icon = "bi-box", Controller = "InventoryReports" },
        new { Section = "",                    Text = "Tổng quan",   Icon = "bi-speedometer2",     Controller = "Home" },
        new { Section = "Hàng hóa",            Text = "Sản phẩm",    Icon = "bi-box-seam",         Controller = "Products" },
        new { Section = "Hàng hóa",            Text = "Danh mục",    Icon = "bi-tags",             Controller = "Categories" },
        new { Section = "Đối tác & nhân sự",   Text = "Khách hàng",  Icon = "bi-people",           Controller = "Customers" },
        new { Section = "Đối tác & nhân sự",   Text = "Nhân viên",   Icon = "bi-person-badge",     Controller = "Employees" },
        new { Section = "Đối tác & nhân sự",   Text = "Nhà cung cấp", Icon = "bi-truck",           Controller = "Suppliers" },
        new { Section = "Kho & bán hàng",      Text = "Nhập kho",    Icon = "bi-box-arrow-in-down", Controller = "PurchaseReceipts" },
        new { Section = "Kho & bán hàng",      Text = "Đơn hàng",    Icon = "bi-receipt",          Controller = "SalesOrders" },
        new { Section = "Phân tích",           Text = "Báo cáo",     Icon = "bi-graph-up",         Controller = "Reports" }
    };

    string currentController = ViewContext.RouteData.Values["controller"] as string;
    string lastSection = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Quản lý bán hàng</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/admin.css" rel="stylesheet" type="text/css" />
    <style>
        @@media print {
            @@page { size: A4; margin: 12mm; }
            .sidebar, .sidebar-overlay, .topbar, .admin-footer, .no-print { display: none !important; }
            .main { margin: 0 !important; padding: 0 !important; width: 100% !important; }
            .admin-content { padding: 0 !important; }
            .table-responsive { overflow: visible !important; }
            thead { display: table-header-group; }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body class="admin-body">

    <aside class="sidebar" id="sidebar">
        <a href="@Url.Action("Index", "Home")" class="sidebar-brand">
            <span class="brand-mark">OS</span>
            <span class="brand-text">
                <strong>Quản lý bán hàng</strong>
                <small>OnlineSalesManagement</small>
            </span>
        </a>

        <nav class="sidebar-nav" aria-label="Menu quản trị">
            @foreach (var item in menu)
            {
                if (!CanAccess(item.Controller)) { continue; }
                if (item.Section != lastSection)
                {
                    lastSection = item.Section;
                    if (item.Section.Length > 0)
                    {
                        <div class="sidebar-heading">@item.Section</div>
                    }
                }

                bool enabled = HasController(item.Controller);
                bool isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                string linkClass = isActive ? "sidebar-link active" : "sidebar-link";

                if (enabled)
                {
                    <a href="@Url.Action("Index", item.Controller)" class="@linkClass" aria-current="@(isActive ? "page" : null)">
                        <i class="bi @item.Icon"></i>
                        <span class="sidebar-text"><span>@item.Text</span></span>
                    </a>
                }
                else
                {
                    <span class="sidebar-link is-disabled" aria-disabled="true" title="Đang phát triển">
                        <i class="bi @item.Icon"></i>
                        <span class="sidebar-text">
                            <span>@item.Text</span>
                            <small>Đang phát triển</small>
                        </span>
                    </span>
                }
            }
        </nav>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" id="sidebarToggle" class="btn btn-light btn-sm d-lg-none" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-app d-none d-sm-inline">Hệ thống quản lý bán hàng</span>
            </div>
            <div class="navbar navbar-expand p-0 topbar-user">
                @Html.Partial("_LoginPartial")
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>

        <footer class="admin-footer">
            &copy; @DateTime.Now.Year - OnlineSalesManagement
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            var overlay = document.getElementById('sidebarOverlay');
            function flip() { document.body.classList.toggle('sidebar-open'); }
            if (toggle) { toggle.addEventListener('click', flip); }
            if (overlay) { overlay.addEventListener('click', flip); }
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
