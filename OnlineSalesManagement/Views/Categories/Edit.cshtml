@model OnlineSalesManagement.Category
@{ ViewBag.Title = Model.Id == 0 ? "Thêm danh mục" : "Sửa danh mục"; }
<h2>@ViewBag.Title</h2>
@using (Html.BeginForm(Model.Id == 0 ? "Create" : "Edit", "Categories", FormMethod.Post)) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)
    <div class="mb-3">@Html.LabelFor(m => m.Name) @Html.TextBoxFor(m => m.Name, new { @class = "form-control", maxlength = "100" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.Description) @Html.TextAreaFor(m => m.Description, new { @class = "form-control", maxlength = "500" })</div>
    <div class="mb-3">@Html.CheckBoxFor(m => m.IsActive) @Html.LabelFor(m => m.IsActive)</div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
}
