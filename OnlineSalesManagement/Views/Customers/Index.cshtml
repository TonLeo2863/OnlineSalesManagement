@model IEnumerable<OnlineSalesManagement.Customer>
@{ ViewBag.Title = "Khách hàng"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="management-page">
<header class="management-heading"><div><span class="management-eyebrow">ĐỐI TÁC &amp; NHÂN SỰ</span><h2>Khách hàng</h2><p>Quản lý thông tin và trạng thái hoạt động.</p></div>@Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })</header>
<div class="management-panel">
@Html.Partial("_PeopleFilters")
<p class="text-muted px-3" role="status">@ViewBag.Total bản ghi · Trang @ViewBag.Page / @ViewBag.PageCount</p>
<div class="table-responsive"><table class="table table-hover management-table"><thead><tr><th>Mã</th><th>Họ tên</th><th>Tài khoản</th><th>Email</th><th>Điện thoại</th><th>Địa chỉ</th><th>Ngày tạo</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr data-active="@(item.IsActive ? "true" : "false")">
<td>@Html.DisplayFor(m => item.Code)</td>
<td>@Html.DisplayFor(m => item.FullName)</td>
<td>@Html.DisplayFor(m => item.User.Email)</td>
<td>@Html.DisplayFor(m => item.Email)</td>
<td>@Html.DisplayFor(m => item.PhoneNumber)</td>
<td>@Html.DisplayFor(m => item.Address)</td>
<td>@Html.DisplayFor(m => item.CreatedDate)</td>
<td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Hoạt động" : "Ngừng hoạt động")</span></td>
<td class="text-end text-nowrap">@Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" }) @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" }) @Html.ActionLink("Xóa", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })</td></tr>
}
</tbody></table>@if (!Model.Any()) { <p class="text-center text-muted p-4">Không có dữ liệu phù hợp.</p> }</div></div></section>
<nav class="d-flex gap-2" aria-label="Phân trang">
@{ int current = (int)ViewBag.Page; int pages = (int)ViewBag.PageCount; }
@foreach(var target in new[] {current-1,current+1}) { if(target<1 || target>pages){continue;} var route = new System.Web.Routing.RouteValueDictionary(); foreach(string key in Request.QueryString.AllKeys){if(key!=null && key!="page"){route[key]=Request.QueryString[key];}}route["page"]=target;<a class="btn btn-outline-primary" href="@Url.Action("Index",route)">@(target<current?"Trang trước":"Trang sau")</a> }
</nav>
