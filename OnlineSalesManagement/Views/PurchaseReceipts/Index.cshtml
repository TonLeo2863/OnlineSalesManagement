
@model IEnumerable<OnlineSalesManagement.PurchaseReceipt>

@{
    ViewBag.Title = "Quản lý nhập kho";
}

<h2>Quản lý nhập kho</h2>

<p>
    @Html.ActionLink(
            "Tạo phiếu nhập mới",
            "Create",
            null,
            new { @class = "btn btn-primary" })
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Số phiếu</th>
            <th>Nhà cung cấp</th>
            <th>Nhân viên</th>
            <th>Trạng thái</th>
            <th>Tổng tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReceiptNumber</td>
                <td>@item.Supplier.Name</td>
                <td>@item.Employee.FullName</td>
                <td>@item.Status</td>
                <td>@item.TotalAmount.ToString("N0") đ</td>
                <td>
                    @Html.ActionLink(
                             "Chi tiết", "Details",
                             new { id = item.Id },
                             new { @class = "btn btn-sm btn-info" })
                </td>
            </tr>
        }
    </tbody>
</table>
